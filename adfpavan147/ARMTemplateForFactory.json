				},
				"parameters": {
					"container": {
						"type": "string",
						"defaultValue": "source"
					},
					"folder": {
						"type": "string",
						"defaultValue": "API"
					},
					"filename": {
						"type": "string",
						"defaultValue": "pokemon.json"
					}
				},
